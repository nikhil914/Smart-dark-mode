{
  "name": "@sdm/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:edge": "wxt build -b edge --mv3",
    "build:opera": "wxt build -b opera --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b chrome --mv3 && wxt zip -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@sdm/settings": "workspace:*",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "wxt": "0.21.5"
  }
}
